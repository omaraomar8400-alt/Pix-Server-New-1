{
  "$schema": "node_modules/wrangler/config-schema.json",
  // مهم: خلّي name زي اللي في ملفك الحالي (نفس اسم الـWorker في Cloudflare)
  "name": "pix-ai",
  "main": "index.js",
  "compatibility_date": "2025-01-01",
  "ai": { "binding": "AI" },
  "vars": {
    "MODEL_LITE": "@cf/meta/llama-3.1-8b-instruct-fast",
    "MODEL_FAST": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "MODEL_FLASH": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "MODEL_CODE": "@cf/qwen/qwen2.5-coder-32b-instruct",
    "MODEL_ULTRA": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "MODEL_VISION": "@cf/meta/llama-3.2-11b-vision-instruct"
  }
}
