{
  // Pix Server v4 ULTRA - Cloudflare Worker
  "name": "pix-server-new-1",
  "main": "index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI (إجباري)
  "ai": {
    "binding": "AI"
  },

  // KV للتخزين + المعرفة + نظام الملفات + نشر المواقع (مستحسن جدًا)
  // بعد ما تعمل namespace من الداشبورد، حط الـ id هنا
  // "kv_namespaces": [
  //   {
  //     "binding": "KB",
  //     "id": "YOUR_KV_NAMESPACE_ID_HERE"
  //   }
  // ],

  // متغيرات (اختياري)
  "vars": {
    "RATE_LIMIT": "120"
  }

  // لو عايز ADMIN_TOKEN حطه من الداشبورد كـ Secret مش هنا
  // Settings → Variables and Secrets → Add → Secret → ADMIN_TOKEN
}
